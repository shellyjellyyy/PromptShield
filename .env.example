# PromptShield Environment Configuration
# Copy this file to .env and insert your API keys

# Primary Model Provider to use in PromptShield: gemini, openai, groq, or mock
DEFAULT_PROVIDER=gemini

# Google Gemini API Key (Get from: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key (Optional, if using GPT models)
OPENAI_API_KEY=your_openai_api_key_here

# Groq API Key (Optional, for ultra-fast Llama-3 inference)
GROQ_API_KEY=your_groq_api_key_here

# Default Model Identifier
DEFAULT_MODEL=gemini-1.5-flash
